{
  "name": "@edgegamers/s2s-hide",
  "version": "1.3.3",
  "description": "An s2script port of edgegamers/CS2-HidePlayers using native clientprefs cookies.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "src/plugin.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShookEagle/s2s-hide.git"
  },
  "bugs": { "url": "https://github.com/ShookEagle/s2s-hide/issues" },
  "homepage": "https://github.com/ShookEagle/s2s-hide#readme",
  "publishConfig": { "access": "public" },
  "files": ["src/", "translations/", "scripts/", "test/", "tsconfig.json", "NOTICE"],
  "scripts": {
    "build": "s2s build .",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs",
    "registry:pack": "s2s pack --dry-run",
    "deploy": "s2s deploy --ci"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@s2script/cs2": "0.22.0",
    "@s2script/sdk": "0.33.0",
    "esbuild": "^0.25.0",
    "fflate": "0.8.2",
    "typescript": "^5.6.0"
  }
}
